<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence ">
    <persistence-unit name="TrungTamDaoTaoPU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- System entities -->
        <class>com.trungtamdaotao.model.entity.system.Staff</class>
        <class>com.trungtamdaotao.model.entity.system.UserAccount</class>
        <class>com.trungtamdaotao.model.entity.system.Notification</class>

        <!-- Core entities -->
        <class>com.trungtamdaotao.model.entity.core.Course</class>
        <class>com.trungtamdaotao.model.entity.core.Teacher</class>
        <class>com.trungtamdaotao.model.entity.core.Student</class>

        <!-- Academic entities -->
        <class>com.trungtamdaotao.model.entity.academic.ClassEntity</class>
        <class>com.trungtamdaotao.model.entity.academic.Result</class>
        <class>com.trungtamdaotao.model.entity.academic.Schedule</class>
        <class>com.trungtamdaotao.model.entity.academic.Attendance</class>
        <class>com.trungtamdaotao.model.entity.academic.Enrollment</class>
        <class>com.trungtamdaotao.model.entity.academic.Certificate</class>
        <class>com.trungtamdaotao.model.entity.academic.PlacementTest</class>

        <!-- Operations entities -->
        <class>com.trungtamdaotao.model.entity.operations.Room</class>
        <class>com.trungtamdaotao.model.entity.operations.Branch</class>
        <class>com.trungtamdaotao.model.entity.operations.Promotion</class>

        <!-- Finance entities -->
        <class>com.trungtamdaotao.model.entity.finance.Invoice</class>
        <class>com.trungtamdaotao.model.entity.finance.Payment</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>